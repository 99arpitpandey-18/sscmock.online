/* =========================================================
   STATE
========================================================= */

let current = 0;
let answers = new Array(questions.length).fill(null);
let marked = new Array(questions.length).fill(false);

let timeLeft = 60 * 60;
let submitted = false;


/* =========================================================
   DISPLAY QUESTION
========================================================= */

function showQuestion(){

    const q = questions[current];

    document.getElementById("subjectBar").textContent =
        q.subject;

    document.getElementById("qNumber").textContent =
        "Question " + (current + 1) + " of " + questions.length;

    document.getElementById("questionText").innerHTML =
        q.q;

    const optionsBox =
        document.getElementById("options");

    optionsBox.innerHTML = "";

    q.o.forEach((option,index)=>{

        const div = document.createElement("div");

        div.className = "option";

        if(answers[current] === index){
            div.classList.add("selected");
        }

        div.innerHTML =
            `<input type="radio"
             name="option"
             ${answers[current] === index ? "checked" : ""}
             onclick="selectAnswer(${index})">
             <span>${String.fromCharCode(65+index)}. ${option}</span>`;

        div.onclick = function(e){

            if(e.target.tagName !== "INPUT"){
                selectAnswer(index);
            }

        };

        optionsBox.appendChild(div);

    });

    createPalette();
}


/* =========================================================
   ANSWER
========================================================= */

function selectAnswer(index){

    answers[current] = index;

    showQuestion();

}


/* =========================================================
   NEXT
========================================================= */

function nextQuestion(){

    if(current < questions.length - 1){

        current++;

        showQuestion();

    }

}


/* =========================================================
   PREVIOUS
========================================================= */

function previousQuestion(){

    if(current > 0){

        current--;

        showQuestion();

    }

}


/* =========================================================
   MARK
========================================================= */

function markQuestion(){

    marked[current] = !marked[current];

    createPalette();

}


/* =========================================================
   PALETTE
========================================================= */

function createPalette(){

    const palette =
        document.getElementById("palette");

    palette.innerHTML = "";

    questions.forEach((q,index)=>{

        const btn =
            document.createElement("button");

        btn.textContent = index + 1;

        if(index === current){
            btn.classList.add("current");
        }

        else if(marked[index]){
            btn.classList.add("marked");
        }

        else if(answers[index] !== null){
            btn.classList.add("answered");
        }

        btn.onclick = function(){

            current = index;

            showQuestion();

        };

        palette.appendChild(btn);

    });

}


/* =========================================================
   TIMER
========================================================= */

function updateTimer(){

    const minutes =
        Math.floor(timeLeft / 60);

    const seconds =
        timeLeft % 60;

    document.getElementById("timer").textContent =
        String(minutes).padStart(2,"0") +
        ":" +
        String(seconds).padStart(2,"0");

    if(timeLeft <= 0){

        submitTest();

        return;

    }

    timeLeft--;

}

setInterval(updateTimer,1000);


/* =========================================================
   SUBMIT
========================================================= */

function submitTest(){

    if(submitted) return;

    const confirmSubmit =
        confirm(
            "Are you sure you want to submit the test?\n\n" +
            "क्या आप test submit करना चाहते हैं?"
        );

    if(!confirmSubmit) return;

    submitted = true;

    document.getElementById("exam").style.display = "none";

    document.getElementById("result").style.display = "block";

    calculateResult();

    window.scrollTo(0,0);

}


/* =========================================================
   RESULT
========================================================= */

function calculateResult(){

    let correct = 0;
    let wrong = 0;
    let unattempted = 0;

    questions.forEach((q,index)=>{

        if(answers[index] === null){

            unattempted++;

        }

        else if(answers[index] === q.a){

            correct++;

        }

        else{

            wrong++;

        }

    });

    const score =
        correct * 2 - wrong * 0.5;

    const percentage =
        (score / 200) * 100;

    const accuracy =
        correct + wrong === 0
        ? 0
        : (correct / (correct + wrong)) * 100;


    document.getElementById("score").textContent =
        score.toFixed(2) + " / 200";

    document.getElementById("percentage").textContent =
        "Percentage: " + percentage.toFixed(2) + "%";


    document.getElementById("correctCount").textContent =
        correct;

    document.getElementById("wrongCount").textContent =
        wrong;

    document.getElementById("unattemptedCount").textContent =
        unattempted;

    document.getElementById("accuracy").textContent =
        accuracy.toFixed(2) + "%";


    createAnalysis();

    createReview();

}


/* =========================================================
   SUBJECT ANALYSIS
========================================================= */

function createAnalysis(){

    const subjects = {};

    questions.forEach((q,index)=>{

        if(!subjects[q.subject]){

            subjects[q.subject] = {
                total:0,
                correct:0,
                wrong:0,
                unattempted:0,
                score:0
            };

        }

        subjects[q.subject].total++;

        if(answers[index] === null){

            subjects[q.subject].unattempted++;

        }

        else if(answers[index] === q.a){

            subjects[q.subject].correct++;

            subjects[q.subject].score += 2;

        }

        else{

            subjects[q.subject].wrong++;

            subjects[q.subject].score -= 0.5;

        }

    });


    const body =
        document.getElementById("analysisBody");

    body.innerHTML = "";

    Object.keys(subjects).forEach(subject=>{

        const s = subjects[subject];

        const row = document.createElement("tr");

        row.innerHTML = `
            <td>${subject}</td>
            <td>${s.total}</td>
            <td>${s.correct}</td>
            <td>${s.wrong}</td>
            <td>${s.unattempted}</td>
            <td>${s.score.toFixed(2)}</td>
        `;

        body.appendChild(row);

    });

}


/* =========================================================
   REVIEW
========================================================= */

function createReview(){

    const box =
        document.getElementById("reviewContainer");

    box.innerHTML = "";

    questions.forEach((q,index)=>{

        const div =
            document.createElement("div");

        div.className = "review-item";

        let status = "";

        if(answers[index] === null){

            status =
                `<span style="color:#d97706">
                    ⚪ Unattempted
                 </span>`;

        }

        else if(answers[index] === q.a){

            status =
                `<span style="color:#15803d">
                    ✅ Correct
                 </span>`;

        }

        else{

            status =
                `<span style="color:#dc2626">
                    ❌ Wrong
                 </span>`;

        }


        const userAnswer =
            answers[index] === null
            ? "Not Attempted"
            : q.o[answers[index]];


        div.innerHTML = `

            <h3>
                Q${index+1}. ${status}
            </h3>

            <p style="margin:12px 0;line-height:1.7">
                ${q.q}
            </p>

            <p>
                <b>Your Answer:</b>
                ${userAnswer}
            </p>

            <p class="correct-answer">
                Correct Answer:
                ${String.fromCharCode(65+q.a)}.
                ${q.o[q.a]}
            </p>

            <div class="explanation">

                <b>Explanation / व्याख्या:</b>

                <br><br>

                ${q.e}

            </div>
        `;

        box.appendChild(div);

    });

}


